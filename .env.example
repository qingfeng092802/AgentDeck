# 环境变量名清单（只列名，取值一律留空）。
# 取值来源：config/params-ref.md §4 / §5 / §6 —— 本文件 MUST NOT 出现任何凭据字面量，
# 真实 .env MUST NOT 入库（见仓库根 .gitignore）。
# 名称性质逐行标注，避免把"我们起的名字"当成"官方规定的名字"：
#   官方 = params-ref / PRD 核实为厂商侧 prescribed；自拟 = 本项目内部命名，待 owner 认

# [官方] 豆包 / 火山方舟 OpenAI 兼容入口（params-ref §4，PRD 6.1 :325）
ARK_API_KEY=

# [官方] DeepSeek 审查席的 API Key（`src/acp/adapters/deepseek/review.py:49`）。
# 只在 `ACP_REVIEW_MODE=deepseek` 时必需；`manual` / `auto` 两档不读它。
DEEPSEEK_API_KEY=

# [自拟] PostgreSQL 事实态连接串（宪法原则 I 的唯一事实库；厂商未 prescribe 名称）
ACP_DB_DSN=

# [自拟] 路径 A（docker compose）初始化容器用的口令；被跟踪的 docker-compose.yml 里只写插值占位，
# 取值落在这里（宪法「二」凭据管理第 1 条）。走路径 B（本机 PG 18）时不用它。
ACP_PG_PASSWORD=

# [自拟·可留空] 路径 A 的**宿主**端口映射（容器内固定 5432）。留空 = 用 docker-compose.yml 的默认 5432，
# 但本机 5432 已被原生 postgresql-x64-18 占用 ⇒ 走容器时需显式写一个空闲端口（实测 5433/5434/5435 可绑），
# 且 ACP_DB_DSN 里的主机端口要与这里一致。
ACP_PG_HOST_PORT=

# [自拟] WorkBuddy / 腾讯云 CAM 的 SecretId / SecretKey 对（TC3-HMAC-SHA256 签名所需）
# 厂商侧不存在"给 WorkBuddy 配一个 xxx_API_KEY"这种凭据形态，勿按直觉命名（见 params-ref §7）
WORKBUDDY_SECRET_ID=
WORKBUDDY_SECRET_KEY=

# [官方·实测] Qoder 侧凭据变量名 —— 取自本机装上的 qoder-agent-sdk 1.0.15 包内源码
# `qoder_agent_sdk/_brand.py`：该构建 SDK_BRAND="global" ⇒
#   PAT 走            QODER_PERSONAL_ACCESS_TOKEN
#   Service Account 走 QODER_SERVICE_ACCOUNT_KEY（宪法「二」推荐：平台用服务型凭据，不依赖个人账号）
# 同文件里另有 CN 构建的一套（QODERCN_*）—— 2026-10-24 起平台**直起 CN CLI**（不经该 SDK 构建），
# 按 owner 裁决 1 使用 CN 名为主变量，见下面那一段；上面这行降为 INTL 品牌的 PAT 名与 CN 的兼容名。
# ⚠️ owner 2026-10-11 临时用的 `QODER_PAT` 不是官方名 ⇒ 需改 .env 里的键名为下面几个之一。
# 取证方式：静态读包内源码（未 import 成功，见 quickstart §2"原生扩展被拦"那行）。
QODER_PERSONAL_ACCESS_TOKEN=

# [官方·实测·2026-10-24 起用] 国内版（CN）执行器的 PAT —— 同名清单的另一支，现在是我们**首选**起的
# CLI（`qoderclicn` / `qodercn`）对应的主变量名（owner 裁决 1：新增此变量）。
# 运行时分派（`src/acp/adapters/qoder/transport.py::_child_env`）：CN 品牌优先读本名、缺了回落
# `QODER_PERSONAL_ACCESS_TOKEN` 并打 warning；落定时**两个名字同值**写进子环境
# （CN CLI 二进制内嵌文档写的是旧名，双写避免赌它读哪个）。
QODERCN_PERSONAL_ACCESS_TOKEN=

# [官方·实测] 同一份 _brand.py 里的 Service Account 形态（宪法「二」推荐平台用它，不依赖个人账号）
# 与 PAT 二选一即可；两个都填时 SDK 侧的优先级待 T001 能真实 import 后再验。
QODER_SERVICE_ACCOUNT_KEY=

# [自拟·可留空] 显式指定 Qoder CLI 可执行文件（`src/acp/adapters/qoder/transport.py:112`）。
# 留空 = 走三档查找：包内 `_bundled` → PATH 上的 `qodercli` / `qodercn`。
QODERCLI_PATH=

# [自拟] 豆包 / 火山方舟的**实际 Model ID**（B 计划 第二步：真跑入口必读这一支）。
# 名字是我们起的，取值是厂商侧的事实：`config/params-ref.md §4` 那张表写明"模型 ID 走环境变量
# `ACP_DOUBAO_MODEL`，代码里不留默认值，缺了由构造点 `SpecRefused` 点名变量名"（MVP-2 笔 H 的裁决）。
# 所以本行按本文件口径留空，**下面那个"默认填写值"是给你抄的示例，不是代码里的回落值**：
#   默认填写值 = doubao-seed-2-1-pro-260915
# 写法只认连字符那一种：点号那种（§7 已否决命名表里那一行）不是官方 ID，填了会撞命名门禁。
# 实际可用型号以方舟控制台那一份 Model ID 为准；换型号只改这一行，代码里不需要跟着改。
ACP_DOUBAO_MODEL=

# [自拟] 审查模式开关（`src/acp/review/policy.py:25`）。只认 manual / deepseek / auto，默认 manual。
#   manual   = 逐卡人工评审
#   deepseek = DeepSeek 审查席给 PASS/FAIL，再按风险档决定谁签（需要 DEEPSEEK_API_KEY）
#   auto     = 门禁代签：产物过门禁即视为通过，不调审查模型
ACP_REVIEW_MODE=

# [自拟] 拆单后的 A 类确认开关（`src/acp/approval/policy.py:30`）。只认 manual / auto，默认 manual。
# 与 ACP_REVIEW_MODE 互不推导：一个管"拆完要不要人批"，一个管"每张卡要不要人审"。
ACP_APPROVAL_MODE=

# [自拟] 立项会讨论轮数（`src/acp/meeting/service.py:57`）。只接 1–3 的整数，默认 2。
ACP_MEETING_ROUNDS=

# [自拟] 低风险自动验收开关（`src/acp/config/auto_approval.py:49`）。只认 1/0/true/false/yes/no/on/off；
# 留空 = 使用 `config/auto_accept.yaml` 的默认口径。
ACP_AUTO_ACCEPT_LOW_RISK=

# [自拟·可留空] 文件总线根（`src/acp/archive/root.py:37`）。留空 = 相对进程工作目录的 `AI项目台`。
# 真跑入口默认使用 `results/`，由 `python -m acp.realrun` 自己传参数，不依赖本变量。
ACP_BUS_ROOT=

# [自拟·可留空] 进化档案根（`src/acp/growth/store.py:29`）。留空 = 仓库根下的 `growth/`。
ACP_GROWTH_ROOT=

# ---------------------------------------------------------------- 一键启动（Docker）
# 下面这几项只有 `docker compose up` 那条路会读，本地手工跑不需要。

# [自拟·可留空] 看板发布到宿主机的端口（`docker-compose.yml` 的 `ports`）。留空 = 8765。
# 容器内部端口固定 8765，只换宿主这一侧；撞端口就改这里，别改镜像里的。
ACP_APP_PORT=

# [自拟·容器专用] 允许绑 0.0.0.0。**只该由 compose 设成 1**，本地手工跑 MUST 留空 ——
# 本仓无鉴权，绑全网卡等于把一个可写的审批决议端点发给局域网。安全边界由发布端口
# （`127.0.0.1:8765:8765`）守着，这一项只是让容器内能收包。
ACP_ALLOW_NON_LOOPBACK=

# [自拟·可留空] 允许提交审批结论的身份，逗号分隔（对应 `--approver`，可重复）。
# 留空 = 看板能看不能批（端点回 503 approvers_not_configured），这是刻意的默认。
ACP_APPROVERS=

# [自拟·可留空] 登记为机器的身份，逗号分隔（对应 `--machine-principal`）。
# 留空 = `PATCH /autonomy` 一律 503 machine_principals_not_configured。
ACP_MACHINE_PRINCIPALS=
